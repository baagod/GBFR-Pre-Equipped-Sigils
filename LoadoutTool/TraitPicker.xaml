<UserControl x:Class="LoadoutTool.TraitPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ComboBox x:Name="Picker" IsEditable="True" StaysOpenOnEdit="True"
              DropDownOpened="Picker_DropDownOpened"
              SelectionChanged="Picker_SelectionChanged"
              LostKeyboardFocus="Picker_LostKeyboardFocus" />
</UserControl>
