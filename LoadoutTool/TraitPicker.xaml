<UserControl x:Class="LoadoutTool.TraitPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Input" TextChanged="Input_TextChanged"
                 GotKeyboardFocus="Input_GotKeyboardFocus"
                 LostKeyboardFocus="Input_LostKeyboardFocus" />
        <TextBlock x:Name="Placeholder" Text="搜索因子并筛选列表"
                   Foreground="Gray" IsHitTestVisible="False"
                   Margin="4,0,0,0" VerticalAlignment="Center" />
        <Popup x:Name="Dropdown" PlacementTarget="{Binding ElementName=Input}"
               Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
               Focusable="False" ClipToBounds="False">
            <Border BorderBrush="#777" BorderThickness="1" Background="White"
                    MaxHeight="260" MinWidth="160" CornerRadius="4">
                <ListBox x:Name="Options" SelectionChanged="Options_SelectionChanged"
                         MouseDown="Options_MouseDown" MaxHeight="258"
                         VirtualizingPanel.ScrollUnit="Pixel" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
