<UserControl x:Class="LoadoutTool.TraitPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBox x:Name="Input"
                     TextChanged="Input_TextChanged"
                     PreviewMouseDown="Input_PreviewMouseDown"
                     LostKeyboardFocus="Input_LostKeyboardFocus" />
            <TextBlock x:Name="Placeholder" Text="搜索因子并筛选列表"
                       Foreground="Gray" IsHitTestVisible="False"
                       Margin="4,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <ListBox x:Name="Options" Grid.Row="1" Visibility="Collapsed"
                 MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="Options_SelectionChanged"
                 MouseDown="Options_MouseDown" />
    </Grid>
</UserControl>
