<ui:FluentWindow x:Class="LoadoutTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LoadoutTool"
        Title="GBFR 预配装配置" Width="700" Height="560" MinWidth="560" MinHeight="420">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SlotItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="槽" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding SlotIndex}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,10,0" />
                                <local:TraitPicker Width="160"
                                                   SelectedTrait="{Binding Trait1}" Margin="0,0,4,0" />
                                <TextBox Width="92" Text="{Binding Level1, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                <TextBlock Text="|" Opacity="0.4" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <local:TraitPicker Width="160"
                                                   SelectedTrait="{Binding Trait2}" Margin="0,0,4,0" />
                                <TextBox Width="92" Text="{Binding Level2, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                <ui:Button Content="−" Width="34" Height="30" Click="RemoveSlot_Click"
                                           Tag="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="添加槽位" Click="AddSlot_Click" Margin="0,0,8,0" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <ui:Button Grid.Row="2" Content="保存并生效" Click="Save_Click"
                   Margin="0,10,0,0" HorizontalAlignment="Right" Width="140" Height="34" />
    </Grid>
</ui:FluentWindow>
