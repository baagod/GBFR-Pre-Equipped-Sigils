<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoadoutTool</AssemblyName>
    <RootNamespace>LoadoutTool</RootNamespace>
    <!-- WPF needs its native libraries (PresentationNative/wpfgfx) extracted
         from the single-file bundle; without this the app crashes at window
         creation with DllNotFoundException. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.0" />
  </ItemGroup>
</Project>
